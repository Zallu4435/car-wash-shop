# App Configuration
NEXT_PUBLIC_APP_NAME="Car Wash Services"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Payment Gateway - Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Feature Flags
NEXT_PUBLIC_ENABLE_COD=true
NEXT_PUBLIC_ENABLE_ADVANCE_PAYMENT=true

# Business Settings
NEXT_PUBLIC_COD_FEE=40
NEXT_PUBLIC_FREE_DELIVERY_MIN=500
NEXT_PUBLIC_ADVANCE_PAYMENT_PERCENTAGE=30

# Contact Information
NEXT_PUBLIC_COMPANY_EMAIL=support@carwash.com
NEXT_PUBLIC_COMPANY_PHONE=+911234567890

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
